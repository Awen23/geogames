{
  "name": "geogames-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:migrate && npm run build:schedule",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs --packages=external --alias:@shared=../shared",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/migrate.cjs --packages=external --alias:@shared=../shared",
    "build:schedule": "esbuild src/db/schedule.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/schedule.cjs --packages=external --alias:@shared=../shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:schedule": "tsx src/db/schedule.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.8.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
